---
layout: base.njk
permalink: /find-a-doctor.html
title: Find a doctor
lastmodDeps:
  - data/doctors.csv
eleventyComputed:
  metaTitle: "Find an RCPD Doctor Near You — {{ regions.total }} Specialists Worldwide"
  description: "Search a community-built directory of {{ regions.total }} clinicians across {{ regions.countryCount }} countries who diagnose and treat RCPD (no-burp syndrome). Browse by country, state, or province."
scripts:
  - /assets/js/doctors.js
---

<section class="page-head section section--tight">
  <div class="wrap">
    <p class="eyebrow">Directory</p>
    <h1>Find a doctor</h1>
    <p class="lead">
      A directory of clinicians who diagnose and treat RCPD, compiled by the community. Search
      by name, clinic, city, state, or country to find someone near you.
    </p>
    <p class="page-head__aside">
      Know a doctor who treats RCPD?
      <a href="{{ 'suggest' | feedbackHref }}">Suggest a doctor&nbsp;&rarr;</a>
    </p>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    {% include "partials/directory-note.njk" %}

    <div class="finder__controls">
      <label class="visually-hidden" for="doctor-search">Search the directory</label>
      <input
        class="finder__search"
        type="search"
        id="doctor-search"
        name="doctor-search"
        placeholder="Search by name, city, state, or country&hellip;"
        autocomplete="off"
        spellcheck="false">
      <p class="finder__count" id="doctor-count" data-total="{{ doctors.length }}">
        {{ doctors.length }} doctors listed
      </p>
    </div>

    <nav class="region-nav" aria-label="Doctors by country">
      <h2 class="region-nav__title">Browse by country</h2>
      <ul class="region-nav__list">
        {%- for country in regions.listed %}
        <li><a href="{{ country.url }}">{{ country.name }} <span>{{ country.count }}</span></a></li>
        {%- endfor %}
        <li><a href="/doctors/">All regions <span>&rarr;</span></a></li>
      </ul>
    </nav>

    <div id="finder-empty" class="callout callout--note" hidden>
      <p>
        No doctors match your search. Try a broader term &mdash; a state, province, or country.
      </p>
      <p>
        Know a doctor near you who treats RCPD?
        <a href="{{ 'suggest' | feedbackHref }}">Suggest a doctor&nbsp;&rarr;</a>
      </p>
    </div>

    <div class="doctor-grid" id="doctor-grid">
      {%- for doc in doctors %}
      {% include "partials/doctor-card.njk" %}
      {%- endfor %}
    </div>

    <p class="figure-note" style="margin-top:2rem">
      This list is community-maintained and may be incomplete or out of date &mdash; always confirm
      a clinician treats RCPD before booking.
    </p>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    {% include "partials/directory-help.njk" %}
  </div>
</section>
